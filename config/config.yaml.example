# ============================================================
# 数据质量稽核系统配置文件（示例）
# ============================================================

# ------------------------------------------------------------
# 数据库连接配置（必需）
# ------------------------------------------------------------
database_host: "your_clickhouse_host"       # ClickHouse服务器地址
database_port: 8123                          # HTTP端口（默认8123）
database_name: "your_database_name"          # 数据库名称
database_user: "your_username"               # 数据库用户名
database_password: "your_password"           # 数据库密码

# ------------------------------------------------------------
# 时间范围配置（必需）
# ------------------------------------------------------------
start_time: "2026-01-01 00:00:00"            # 稽核开始时间（格式: YYYY-MM-DD HH:MM:SS）
end_time: "2026-01-02 00:00:00"              # 稽核结束时间（格式: YYYY-MM-DD HH:MM:SS）

# ------------------------------------------------------------
# 目录配置（可选，有默认值）
# ------------------------------------------------------------
tasks_dir: "./config/tasks"                  # 任务配置目录（默认: ./config/tasks）
sql_templates_dir: "./sql_templates"         # SQL模板根目录（默认: ./sql_templates）
report_output_dir: "./output"                # 报告输出目录（默认: ./output）
log_output_dir: "./logs"                     # 日志输出目录（默认: ./logs）
